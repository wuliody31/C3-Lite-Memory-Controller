# Copy this file to .env and edit values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Pilot example:
# DATASET_PATH=../Dataset_A_v0_1
# DATASET_PATH=../Dataset_A_v0_1_Neo4j_Episodic_Engineer
# Final example:
# DATASET_PATH=../Dataset_A_v0_2_Neo4j_Expanded
DATASET_PATH=../Dataset_A_v0_1

# mock = deterministic evidence summary, no API cost
# openai = use OpenAI API
ANSWER_MODE=mock

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
